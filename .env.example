# Copie este arquivo para ".env.local" e preencha com os valores reais.
# O ".env.local" NUNCA deve ir para o GitHub (o .gitignore já cuida disso) —
# é onde ficam os segredos de verdade.

# String de conexão do Neon (Project → Connection Details → "Pooled connection")
DATABASE_URL=postgres://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require

# Uma string longa e aleatória, usada para assinar os tokens de login (JWT).
# Gere uma nova com o comando: openssl rand -base64 48
# (ou peça para o Claude gerar uma para você)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa-e-unica
